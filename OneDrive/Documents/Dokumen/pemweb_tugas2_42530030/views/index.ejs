<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= judul %></title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <h1>Daftar Menu Kedai Senja</h1>

        <p>Silakan pilih makanan atau minuman favorit Anda.</p>

        <div class="filter">
            <a href="/">Semua Menu</a>
            <a href="/?kategori=makanan">Makanan</a>
            <a href="/?kategori=minuman">Minuman</a>
        </div>

        <div class="menu-container">

            <% if (menu.length === 0) { %>
                <p>Menu tidak ditemukan.</p>
            <% } %>

            <% menu.forEach(item => { %>

                <div class="menu-card">

                    <img src="<%= item.foto %>" alt="<%= item.nama %>">

                    <h3><%= item.nama %></h3>

                    <p>Rp <%= item.harga.toLocaleString('id-ID') %></p>

                    <a href="/menu/<%= item.id %>">
                        Lihat Detail
                    </a>

                </div>

            <% }) %>

        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>